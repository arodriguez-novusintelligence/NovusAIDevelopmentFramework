# NADF-GUIDE
# Propósito: Plantilla local de variables para el prototipo M6 Cloud Agent.
# Configuración: Copiar a .env (no versionado) y completar CURSOR_API_KEY, repos, refs y flags. Nunca poner AWS keys ni secretos reales aquí.
# Cursor API key (https://cursor.com/dashboard/integrations)
CURSOR_API_KEY=

# Model id (composer-2.5 | auto | list via Cursor.models.list)
NADF_MODEL=composer-2.5

# Project id under .nadf/projects/
NADF_PROJECT_ID=novus-intelligence

# Repos (HTTPS). Framework is always required.
NADF_REPO_FRAMEWORK=https://github.com/arodriguez-novusintelligence/NovusAIDevelopmentFramework.git
NADF_REPO_LOVABLE=https://github.com/arodriguez-novusintelligence/novus-nexus.git
# Optional for later Executor steps (not required for paso-01 analyzer):
# NADF_REPO_FRONTEND=https://github.com/arodriguez-novusintelligence/NovusIntelligenceWEB.git
# NADF_REPO_BACKEND=https://github.com/arodriguez-novusintelligence/NovusIntelligenceBack.git

# Optional starting refs (branch/tag/commit). Leave empty for default branch.
NADF_REF_FRAMEWORK=feature/nadf-foundation
NADF_REF_LOVABLE=

# Target env (informational for prompts / future steps)
NADF_TARGET_ENV=dev
NADF_TARGET_REGION=sa-east-1

# Optional for later Executor steps:
NADF_REPO_FRONTEND=https://github.com/arodriguez-novusintelligence/NovusIntelligenceWEB.git
NADF_REPO_BACKEND=https://github.com/arodriguez-novusintelligence/NovusIntelligenceBack.git

# Auto-create PR for artifact commits / executor PRs
NADF_AUTO_CREATE_PR=true

# --- Visual parity (exacta, sin copiar Lovable) ---
# URL del preview/build de Lovable o novus-nexus desplegado
NADF_LOVABLE_REFERENCE_URL=
NADF_DEV_FRONTEND_URL=https://d1bfu6klutpp8m.cloudfront.net
NADF_VISUAL_PARITY_MAX_DIFF_RATIO=0.002
NADF_REQUIRE_VISUAL_PARITY=true

# --- Post-pipeline DEV (nunca PROD) ---
# smoke=true → verifica cableado agents; NO merge/deploy
NADF_SMOKE_TEST=false
# false en piloto = permite merge WEB/Back + Deploy DEV tras gates PASS
NADF_PROTECT_ARCHETYPE=false
NADF_ARTIFACTS_REMOTE_ONLY=true
NADF_AUTO_MERGE_DEV=true
NADF_AUTO_DEPLOY_DEV=true

{
  "name": "@nadf/m6-cloud-agent-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "NADF M6 prototype: invoke lovable-analyzer-agent via Cursor Cloud Agent",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "invoke:lovable-analyzer": "tsx src/invoke-lovable-analyzer.ts",
    "invoke:planner": "tsx src/invoke-planner.ts",
    "invoke:backend-impact": "tsx src/invoke-backend-impact.ts",
    "invoke:architect": "tsx src/invoke-architect.ts",
    "invoke:remaining-pipeline": "tsx src/invoke-remaining-pipeline.ts",
    "route:lovable-change": "tsx src/route-lovable-change.ts",
    "route:complexity": "tsx src/route-complexity.ts",
    "route:doevents-issue": "tsx src/route-doevents-issue.ts",
    "build:doevents-prompt": "tsx src/build-doevents-prompt.ts",
    "invoke:doevents-issue": "tsx src/invoke-doevents-issue.ts",
    "test:complexity-routing": "tsx tests/complexity-routing/run-corpus.ts",
    "invoke:visual-parity": "tsx src/invoke-visual-parity.ts",
    "invoke:full-pipeline": "tsx src/invoke-full-pipeline.ts",
    "invoke:remediate-cors": "tsx src/invoke-remediate-cors.ts",
    "visual-parity-check": "tsx src/visual-parity-check.ts",
    "post-pipeline-dev": "tsx src/post-pipeline-dev.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "playwright:install": "playwright install chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.18",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

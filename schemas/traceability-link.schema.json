{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nadf.novusintelligence.local/schemas/traceability-link.schema.json",
  "title": "TraceabilityLink",
  "description": "Append-only link between entities",
  "schemaVersion": "1.1.0-rc.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "from_type",
    "from_id",
    "to_type",
    "to_id",
    "relation",
    "created_at",
    "correlation_id",
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.1.0-rc.1",
      "description": "Schema package version"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Z]{2,6}-[0-9]{4}-[0-9]{6}$|^[a-z0-9][a-z0-9_.:-]{2,}$"
    },
    "from_type": {
      "type": "string"
    },
    "from_id": {
      "type": "string"
    },
    "to_type": {
      "type": "string"
    },
    "to_id": {
      "type": "string"
    },
    "relation": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nadf.novusintelligence.local/schemas/agent-version.schema.json",
  "title": "AgentVersion",
  "description": "Published immutable agent version",
  "schemaVersion": "1.1.0-rc.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id",
    "version",
    "status",
    "published_at",
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.1.0-rc.1",
      "description": "Schema package version"
    },
    "agent_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PUBLISHED",
        "DEPRECATED",
        "RETIRED"
      ]
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

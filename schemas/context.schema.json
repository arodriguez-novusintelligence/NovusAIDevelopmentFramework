{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nadf.novusintelligence.local/schemas/context.schema.json",
  "title": "Context",
  "description": "Assembled project context snapshot",
  "schemaVersion": "1.1.0-rc.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "project_id",
    "assembled_at",
    "correlation_id",
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.1.0-rc.1",
      "description": "Schema package version"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Z]{2,6}-[0-9]{4}-[0-9]{6}$|^[a-z0-9][a-z0-9_.:-]{2,}$"
    },
    "project_id": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assembled_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nadf.novusintelligence.local/schemas/event.schema.json",
  "title": "EventEnvelope",
  "description": "Typed NADF event envelope",
  "schemaVersion": "1.1.0-rc.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "version",
    "id",
    "correlation_id",
    "occurred_at",
    "producer",
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.1.0-rc.1",
      "description": "Schema package version"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Z]{2,6}-[0-9]{4}-[0-9]{6}$|^[a-z0-9][a-z0-9_.:-]{2,}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  }
}

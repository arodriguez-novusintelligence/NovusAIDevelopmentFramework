{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nadf.novusintelligence.local/schemas/execution-plan.schema.json",
  "title": "ExecutionPlan (Plan alias)",
  "description": "Approved Plan + task list; alias of Meta Model Plan after approval",
  "schemaVersion": "1.1.0-rc.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "intent_id",
    "kind",
    "status",
    "tasks",
    "correlation_id",
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.1.0-rc.1",
      "description": "Schema package version"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Z]{2,6}-[0-9]{4}-[0-9]{6}$|^[a-z0-9][a-z0-9_.:-]{2,}$"
    },
    "intent_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "plan",
        "execution-plan",
        "mission"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PENDING_REVIEW",
        "APPROVED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8
    },
    "version": {
      "type": "string"
    }
  }
}

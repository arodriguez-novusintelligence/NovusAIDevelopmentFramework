{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nadf.novusintelligence.local/schemas/execution.schema.json",
  "title": "Execution",
  "description": "Immutable historical execution record",
  "schemaVersion": "1.1.0-rc.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "plan_id",
    "status",
    "started_at",
    "correlation_id",
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.1.0-rc.1",
      "description": "Schema package version"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Z]{2,6}-[0-9]{4}-[0-9]{6}$|^[a-z0-9][a-z0-9_.:-]{2,}$"
    },
    "plan_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "STARTED",
        "RUNNING",
        "COMPLETED",
        "FAILED",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8
    }
  }
}
